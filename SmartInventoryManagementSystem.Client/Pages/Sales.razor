@page "/sales"
@attribute [Authorize]
@inject HttpClient Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.SaleDTO


<div class="card shadow-sm border-0 mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h3 class="fw-bold text-primary m-0">Sales</h3>

        <span class="text-muted">
            @(sales == null || sales.Count == 0
                        ? "No sales yet"
                        : $"{sales.Count} sale(s)")
        </span>
    </div>
</div>

@if (sales == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Loading sales...</p>
    </div>
}
else if (!sales.Any())
{
    <div class="alert alert-info text-center shadow-sm">
        No sales have been recorded yet.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-primary text-dark">
                        <tr>
                            <th style="width: 30%">Date</th>
                            <th style="width: 30%">Total</th>
                            <th style="width: 20%" class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var sale in sales)
                        {
                            <tr>
                                <td>@sale.SaleDate.ToShortDateString()</td>

                                <td class="fw-semibold">
                                    £@sale.TotalAmount
                                </td>

                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="/sales/@sale.SaleId">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}


@code {
    List<GetAllSales>? sales;

    protected override async Task OnInitializedAsync()
    {
        sales = await Http.GetFromJsonAsync<List<GetAllSales>>("api/sales/GetAllSales");
    }
}

