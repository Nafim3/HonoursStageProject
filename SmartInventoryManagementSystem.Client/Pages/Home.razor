@page "/dashboard"
@attribute [Authorize]
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SmartInventoryManagementSystem.Application.DTO
@using SmartInventoryManagementSystem.Client.Authentication
@using SmartInventoryManagementSystem.Client.Service
@inject HttpClient Http
@inject APIService ApiService
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4">

    <div class="text-end mb-3">
        <button class="btn btn-outline-danger" @onclick="Logout">Logout</button>
    </div>


    <h2 class="text-center mb-4 text-info fw-bold">
        Inventory Management System
    </h2>

    @if (dashboard == null)
    {
        <p class="text-center text-muted">Loading dashboard...</p>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="row g-4">

            <div class="col-md-4">
                <div class="card bg-dark text-center p-4 shadow border-info border-1">
                    <h6 class="text-uppercase text-muted">Total Products</h6>
                    <h2 class="fw-bold text-info display-6">@dashboard.TotalProducts</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark text-center p-4 shadow border-success border-1">
                    <h6 class="text-uppercase text-muted">Sales Today</h6>
                    <h2 class="fw-bold text-success display-6">@dashboard.SalesToday</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark text-center p-4 shadow border-danger border-1">
                    <h6 class="text-uppercase text-muted">Low Stock Items</h6>
                    <h2 class="fw-bold text-danger display-6">@dashboard.LowStockCount</h2>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card bg-dark text-center p-4 shadow border-danger border-1">
                    <h6 class="text-uppercase text-muted">Expired Products</h6>
                    <h2 class="fw-bold text-danger display-6">@dashboard.ExpiredProductsCount</h2>
                </div>
            </div>


        </div>

        <hr class="my-5 border-secondary" />

        <!-- Quick Actions -->
        <h4 class="text-info mb-3">Quick Actions</h4>

        <div class="row g-3">

            <div class="col-md-3">
                <a class="btn btn-outline-info w-100 py-3 fw-bold" href="/products">
                    Manage Products
                </a>
            </div>

            <div class="col-md-3">
                <a class="btn btn-outline-success w-100 py-3 fw-bold" href="/sales">
                    View Sales
                </a>
            </div>

            <div class="col-md-3">
                <a class="btn btn-outline-success w-100 py-3 fw-bold" href="/sales/create">
                    Make a Sale
                </a>
            </div>

        </div>
    }
</div>

@code 
{
    Dashboard? dashboard;

    protected override async Task OnInitializedAsync()
    {
        var client = await ApiService.GetAuthorizedClient();
        dashboard = await client.GetFromJsonAsync<Dashboard>("api/dashboard");
    }

    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider customProvider)
            await customProvider.NotifyUserLogout();
        else
            await LocalStorage.RemoveItemAsync("accessToken");

        try { Http.DefaultRequestHeaders.Authorization = null; } catch { }

        Nav.NavigateTo("/", true);
    }

}
