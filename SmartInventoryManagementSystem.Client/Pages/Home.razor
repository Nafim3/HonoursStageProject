@page "/dashboard"
@attribute [Authorize]
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SmartInventoryManagementSystem.Application.DTO
@using SmartInventoryManagementSystem.Client.Authentication
@using SmartInventoryManagementSystem.Client.Service
@inject HttpClient Http
@inject APIService ApiService
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="container py-4">

    <!-- Logout -->
    <div class="d-flex justify-content-end align-items-center gap-3 mb-4">

        <!-- Bell Icon -->
        <div class="dropdown">
            <button class="btn position-relative" @onclick="Toggle">
                <i class="bi bi-bell fs-5"></i>

                @if (Alerts.Any())
                {
                    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                        @Alerts.Count
                    </span>
                }
            </button>

            @if (IsOpen)
            {
                <div class="dropdown-menu dropdown-menu-end show shadow">
                    @if (!Alerts.Any())
                    {
                        <div class="dropdown-item text-muted">No notifications</div>
                    }
                    else
                    {
                        @foreach (var alert in Alerts)
                        {
                            <div class="dropdown-item alert-item"
                                 @onclick="() => Navigate(alert)">
                                <strong class="@GetColor(alert.Category)">
                                    @alert.Category:
                                </strong>
                                @alert.Message
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <!-- Account Dropdown -->
        <div class="dropdown">
            <button class="btn btn-light dropdown-toggle"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                Account
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li>
                    <button class="dropdown-item text-danger"
                            @onclick="Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>
                </li>
            </ul>
        </div>

    </div>


    <!-- Title -->
    <h2 class="text-center mb-5 text-primary fw-bold">
        Inventory Management System
    </h2>

    @if (dashboard == null)
    {
        <div class="text-center text-muted py-5">
            <div class="spinner-border text-primary mb-3"></div>
            <p>Loading dashboard...</p>
        </div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="row g-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-primary">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Total Products</h6>
                        <h2 class="fw-bold text-primary">@dashboard.TotalProducts</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-success">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Sales Today</h6>
                        <h2 class="fw-bold text-success">@dashboard.SalesToday</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-warning">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Low Stock Items</h6>
                        <h2 class="fw-bold text-warning">@dashboard.LowStockCount</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-danger">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Expired Products</h6>
                        <h2 class="fw-bold text-danger">@dashboard.ExpiredProductsCount</h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- Divider -->
        <hr class="my-5 opacity-25" />

        <!-- Quick Actions -->
        <h4 class="text-primary mb-3 fw-semibold">Quick Actions</h4>

        <div class="row g-3">

            <div class="col-md-3">
                <a class="btn btn-outline-primary w-100 py-3 fw-bold" href="/products">
                    <i class="bi bi-box-seam me-1"></i> Manage Products
                </a>
            </div>

            <div class="col-md-3">
                <a class="btn btn-outline-success w-100 py-3 fw-bold" href="/sales">
                    <i class="bi bi-receipt me-1"></i> View Sales
                </a>
            </div>

            <div class="col-md-3">
                <a class="btn btn-outline-info w-100 py-3 fw-bold" href="/sales/create">
                    <i class="bi bi-cart-plus me-1"></i> Make a Sale
                </a>
            </div>

        </div>
    }
</div>


@code 
{
    Dashboard? dashboard;

    private bool IsOpen;
    private List<AlertDTO> Alerts = new();

    protected override async Task OnInitializedAsync()
    {
        var client = await ApiService.GetAuthorizedClient();
        await client.GetAsync("api/product/Expired-products/check");
        dashboard = await client.GetFromJsonAsync<Dashboard>("api/dashboard");

        await LoadAlertsAsync();


    }

    private async Task LoadAlertsAsync()
    {
        Alerts = await Http
            .GetFromJsonAsync<List<AlertDTO>>("api/alert/bell")
            ?? new();
    }

    private void Toggle()
    {
        IsOpen = !IsOpen;
    }

    private void Navigate(AlertDTO alert)
    {
        IsOpen = false;

        if (alert.Category == "Expired")
            Nav.NavigateTo("/products/expired");
        else
            Nav.NavigateTo("/products/low-stock");
    }

    private string GetColor(string category)
        => category == "Expired"
           ? "text-danger"
           : "text-warning";



    private async Task Logout()
    {
        try
        {
            // Notify the auth provider
            if (AuthStateProvider is CustomAuthStateProvider customProvider)
                await customProvider.NotifyUserLogout();

            // 2. Remove tokens from storage
            await LocalStorage.RemoveItemAsync("accessToken");
            await LocalStorage.RemoveItemAsync("refreshToken");

            // Clear HttpClient auth header
            Http.DefaultRequestHeaders.Authorization = null;
        }
        catch
        {}

        // 4. Redirect
        Nav.NavigateTo("/");

    }

}
