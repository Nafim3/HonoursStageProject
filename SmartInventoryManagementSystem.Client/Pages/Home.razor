@page "/"
@using System.Net.Http.Json
@using SmartInventoryManagementSystem.Application.DTO
@inject HttpClient Http

<h2 class="text-center mb-4">Smart Inventory Management System</h2>

@if (dashboard == null)
{
    <p class="text-center">Loading dashboard...</p>
}
else
{
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card text-center p-4 shadow-sm">
                <h6>Total Products</h6>
                <h2 class="fw-bold text-info">@dashboard.TotalProducts</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center p-4 shadow-sm">
                <h6>Sales Today</h6>
                <h2 class="fw-bold text-success">@dashboard.SalesToday</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center p-4 shadow-sm">
                <h6>Low Stock Items</h6>
                <h2 class="fw-bold text-danger">@dashboard.LowStockCount</h2>
            </div>
        </div>

    </div>

    <hr class="my-4" />

    <div class="row g-3">
        <div class="col-md-3">
            <a class="btn btn-primary w-100 py-3" href="/products">Manage Products</a>
        </div>

        <div class="col-md-3">
            <a class="btn btn-primary w-100 py-3" href="/sales">View Sales</a>
        </div>
    </div>
}

@code 
{
    Dashboard? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await Http.GetFromJsonAsync<Dashboard>("api/dashboard");
    }
}
