@page "/dashboard"
@attribute [Authorize]
@using System.Net.Http.Json
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using SmartInventoryManagementSystem.Application.DTO.DashboardDTO
@using SmartInventoryManagementSystem.Application.DTO.NotificationDTO
@using SmartInventoryManagementSystem.Client.Authentication
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider


<div class="container py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">

       
        <button class="btn btn-outline-primary" @onclick="ToggleSidebar">
            <i class="bi bi-list fs-3"></i>
        </button>

       
        <div class="d-flex align-items-center gap-3">

          
            <div class="dropdown">
                <button class="btn position-relative" @onclick="Toggle">
                    <i class="bi bi-bell fs-5"></i>
                    @if (Alerts.Any())
                    {
                        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                            @Alerts.Count
                        </span>
                    }
                </button>

                @if (IsOpen)
                {
                    <div class="dropdown-menu dropdown-menu-end show shadow">
                        @if (!Alerts.Any())
                        {
                            <div class="dropdown-item text-muted">No notifications</div>
                        }
                        else
                        {
                            @foreach (var alert in Alerts)
                            {
                                <div class="dropdown-item alert-item">
                                    <strong class="@GetColor(alert.Category)">
                                        @alert.Category:
                                    </strong>
                                    @alert.Message
                                </div>
                            }
                        }
                    </div>
                }
            </div>

          
            <div class="dropdown">
                <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle"></i> Account
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">

                    <li>
                        <a class="dropdown-item" href="/delete-account">
                            <i class="bi bi-person-x me-2"></i> Delete Your Account
                        </a>
                    </li>

                    <li>
                        <button class="dropdown-item text-danger" @onclick="Logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </button>
                    </li>
                </ul>
            </div>

        </div>
    </div>

   
    <div class="sidebar @(SidebarOpen ? "open" : "")">

        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-sm btn-light" @onclick="ToggleSidebar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <h5 class="fw-bold text-primary mb-4">Navigation</h5>

        <a href="/analytics" class="sidebar-link">
            <i class="bi bi-graph-up-arrow me-2"></i> Revenue Analytics
        </a>

        <a href="/prediction/dashboard" class="sidebar-link">
            <i class="bi bi-robot me-2"></i> Inventory Predictor
        </a>

        <a href="/managenotifications" class="sidebar-link">
            <i class="bi bi-info-circle me-2"></i> Manage Notifications
        </a>


    </div>



    <h2 class="text-center mb-5 text-primary fw-bold">Inventory Management System</h2>

    @if (dashboard == null)
    {
        <div class="text-center text-muted py-5">
            <div class="spinner-border text-primary mb-3"></div>
            <p>Loading dashboard...</p>
        </div>
    }
    else
    {

        <div class="row g-4">

            <div class="col-md-3">
                <div class="card shadow-sm border-primary">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Total Products</h6>
                        <h2 class="fw-bold text-primary">@dashboard.TotalProducts</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-success">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Sales Today</h6>
                        <h2 class="fw-bold text-success">@dashboard.SalesToday</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-warning">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Low Stock Items</h6>
                        <h2 class="fw-bold text-warning">@dashboard.LowStockCount</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm border-danger">
                    <div class="card-body text-center">
                        <h6 class="text-uppercase text-muted small">Expired Products</h6>
                        <h2 class="fw-bold text-danger">@dashboard.ExpiredProductsCount</h2>
                    </div>
                </div>
            </div>

        </div>


        <hr class="my-5 opacity-25" />
        <h4 class="text-primary mb-3 fw-semibold">Quick Actions</h4>
        <div class="row g-3">
            <div class="col-md-3">
                <a class="btn btn-outline-primary w-100 py-3 fw-bold" href="/products">
                    <i class="bi bi-box-seam me-1"></i> Manage Products
                </a>
            </div>
            <div class="col-md-3">
                <a class="btn btn-outline-success w-100 py-3 fw-bold" href="/sales">
                    <i class="bi bi-receipt me-1"></i> View Sales
                </a>
            </div>
            <div class="col-md-3">
                <a class="btn btn-outline-info w-100 py-3 fw-bold" href="/sales/create">
                    <i class="bi bi-cart-plus me-1"></i> Make a Sale
                </a>
            </div>

        </div>
    }

    <div class="chatbot-button" @onclick="ToggleChat">
        💬
    </div>

    @if (IsChatOpen)
    {
        <div class="chat-window">
            <div class="chat-header">
                Inventory Assistant
                <span class="close-btn" @onclick="ToggleChat">✖</span>
            </div>

            <div class="chat-body">
                @foreach (var msg in Messages)
                {
                    <div class="chat-message">@msg</div>
                }
            </div>

            <div class="chat-input">
                <input @bind="UserInput" @onkeydown="HandleKey" placeholder="Ask about risk or reorder..." />
                <button @onclick="SendMessage">Send</button>
            </div>
        </div>
    }


</div>

<style>
    .sidebar {
        position: fixed;
        top: 90px;
        left: 20px;
        width: 240px;
        background: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        transform: translateX(-300px);
        transition: transform 0.3s ease;
        z-index: 2000;
    }

        .sidebar.open {
            transform: translateX(0);
        }

    .sidebar-link {
        display: block;
        padding: 10px 0;
        color: #333;
        text-decoration: none;
        font-weight: 500;
    }

        .sidebar-link:hover {
            color: #0d6efd;
        }

    .sidebar:focus, .sidebar *:focus, button:focus {
        outline: none !important;
        box-shadow: none !important;
    }

    .chatbot-button {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #343a40;
        color: white;
        padding: 12px 16px;
        border-radius: 50%;
        cursor: pointer;
        font-size: 20px;
    }

    .chat-window {
        position: fixed;
        bottom: 80px;
        right: 20px;
        width: 320px;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: slideUp 0.25s ease-out;
    }

    @@keyframes slideUp {
        from {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .chat-header {
        background: #343a40;
        color: white !important;
        padding: 12px 16px;
        font-weight: bold;
        display: flex;
        justify-content: space-between;
        font-size: 16px;
    }

    .chat-body {
        padding: 12px;
        height: 240px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .chat-message {
        background: #f1f1f1;
        padding: 8px 12px;
        border-radius: 12px;
        max-width: 80%;
        font-size: 14px;
    }

    .chat-input {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ddd;
        background: rgba(255,255,255,0.9);
    }

        .chat-input input {
            flex: 1;
            padding: 8px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        .chat-input button {
            margin-left: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            background: #343a40;
            color: white;
            border: none;
        }

    .close-btn {
        cursor: pointer;
    }
    /* Razor-safe text visibility fix */

    .chat-window {
        color: #000 !important;
    }

    .chat-body, .chat-message, .chat-input, .chat-input input, .chat-input button {
        color: #000 !important;
    }
</style>


@code
{

    bool SidebarOpen = false;

    void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }


    Dashboard? dashboard;
    private bool IsOpen;
    private List<AlertDTO> Alerts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        await LoadAlertsAsync();
    }

    private async Task LoadDashboardAsync()
    {
        await Http.GetAsync("api/product/Expired-products/check");
        dashboard = await Http.GetFromJsonAsync<Dashboard>("api/dashboard");
    }

    private async Task LoadAlertsAsync()
    {
        Alerts = await Http.GetFromJsonAsync<List<AlertDTO>>("api/alert/bell") ?? new();
    }

    private void Toggle() => IsOpen = !IsOpen;


    private string GetColor(string category) => category == "Expired" ? "text-danger" : "text-warning";

    private async Task Logout()
    {
        if (AuthStateProvider is CustomAuthStateProvider customProvider)
            await customProvider.NotifyUserLogout();

        Nav.NavigateTo("/");
    }

    private bool IsChatOpen = false;
    private string UserInput = string.Empty;
    private List<string> Messages = new();

    private void ToggleChat()
    {
        IsChatOpen = !IsChatOpen;
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(UserInput))
            return;

        Messages.Add("You: " + UserInput);

        string response = GetBotResponse(UserInput);

        Messages.Add("Assistant: " + response);

        UserInput = string.Empty;
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SendMessage();
    }

    private string GetBotResponse(string input)
    {
        input = input.ToLower();

        if (input.Contains("risk"))
            return "Risk level is determined by estimated days remaining based on 30-day sales history.";

        if (input.Contains("reorder"))
            return "Reorder quantity is calculated to maintain 14 days of stock coverage.";

        if (input.Contains("days"))
            return "Estimated Days Remaining is calculated by dividing stock quantity by average daily sales.";

        return "I can help explain risk level, reorder quantity, or prediction logic.";
    }

}