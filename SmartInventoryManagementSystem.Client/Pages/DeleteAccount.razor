@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Nav
@inject CustomAuthStateProvider AuthStateProvider
@page "/delete-account"
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.AuthDTO
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text
@using SmartInventoryManagementSystem.Client.Authentication


<div class="container d-flex justify-content-center q-mt-xl">
    <div class="col-12 col-md-8 col-lg-6">

        <br><br><br><br>
        <h3 class="text-danger mb-3">Account Deletion</h3>

        <p class="text-muted mb-4">
            Deleting your account will permanently deactivate it.
            You will lose access to your data and will not be able to log in again.
        </p>

        @if (!showConfirm)
        {
            <button class="btn btn-danger btn-lg w-100" @onclick="ShowConfirmation">
                Delete My Account
            </button>
        }
        else
        {
            <div class="card border-danger mb-3">
                <div class="card-body">

                    <h5 class="text-danger mb-2">Are you absolutely sure?</h5>

                    <p class="text-muted mb-3">
                        This action cannot be undone <br>
                        Enter your password to confirm
                    </p>

                    <input type="password"
                           placeholder="Enter your password"
                           @bind="password"
                           class="form-control mb-3" />

                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-danger flex-fill" @onclick="DeleteMyAccount">
                            Confirm Delete
                        </button>

                        <button class="btn btn-secondary flex-fill" @onclick="CancelDelete">
                            Cancel
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <p class="fw-semibold mt-2">@ErrorMessage</p>
                    }
                </div>
            </div>
        }
    </div>
</div>



@code 
{
    bool showConfirm = false;
    string password = "";
    string ErrorMessage = "";

    void ShowConfirmation()
    {
        showConfirm = true;
    }

    void CancelDelete()
    {
        showConfirm = false;
        password = "";
    }

    async Task DeleteMyAccount()
    {
        var request = new
        {
            Password = password
        };

        var json = JsonSerializer.Serialize(request);
        var content = new StringContent(json, Encoding.UTF8, "application/json");

        var response = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Post, "api/auth/delete-account/me")
        {
            Content = content
        });

        if (!response.IsSuccessStatusCode)
        {
            ErrorMessage = "Incorrect password or error occurred";
            return;
        }

        // Logout user properly
        await AuthStateProvider.NotifyUserLogout();

        // Redirect to login
        Nav.NavigateTo("/");
    }
}