@page "/products"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.ProductDTO



<div class="container py-4">


    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary">Products</h3>

        <a class="btn btn-primary fw-semibold" href="/products/add">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </a>
    </div>


    @if (products == null)
    {
        <div class="alert alert-secondary text-center shadow-sm">
            Loading products...
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info text-center shadow-sm">
            No products found.
        </div>
    }
    else
    {
     
        <div class="card shadow-sm border-0">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-primary text-dark">
                            <tr>
                                <th>Name</th>
                                <th>Price</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Reorder Level</th>

                                <th style="width: 160px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in products)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td>£@p.Price</td>
                                    <td class="text-center">@p.Quantity</td>
                                    <td class="text-center">@p.ReorderLevel</td>


                                    <td>
                                        <a class="btn btn-sm btn-primary me-2"
                                           href="/products/edit/@p.ProductId">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>

                                        <button class="btn btn-sm btn-danger"
                                                @onclick="() => ConfirmDelete(p.ProductId, p.Name ?? string.Empty)">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }
</div>


@code {
    List<ProductListDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await Http.GetFromJsonAsync<List<ProductListDto>>("api/product");

    }

    async Task ConfirmDelete(int id, string name)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {name}?"))
        {
            await Http.DeleteAsync($"api/product/DeleteProduct/{id}");
            products = await Http.GetFromJsonAsync<List<ProductListDto>>("api/product");
        }
    }
}
