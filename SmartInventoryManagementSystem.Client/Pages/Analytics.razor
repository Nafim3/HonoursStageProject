@attribute [Authorize]
@page "/analytics"
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject IJSRuntime JS


<a href="/dashboard"
   style="
        display:inline-block;
        padding:10px 18px;
        background:#3f51b5;
        color:white;
        border-radius:8px;
        text-decoration:none;
        font-weight:600;
        position:relative;
        left:20px;
        top:10px;">
    Back to Dashboard
</a>


<div style="max-width:800px; margin:40px auto;">
    <canvas id="revenueChart"></canvas>
</div>

@if (salesData.Any())
{
    var latest = salesData
        .OrderByDescending(x => x.Year)
        .ThenByDescending(x => x.Month)
        .FirstOrDefault();

    <div style="padding-top:10px; margin-top:20px;">
        <h3 style="text-align:center; margin-bottom:25px;">
            Monthly Revenue History
        </h3>

        @foreach (var item in salesData
            .OrderByDescending(x => x.Year)
            .ThenByDescending(x => x.Month))
        {
            <div style="
                        max-width:500px;
                        margin:12px auto;
                        padding:18px 25px;
                        border-radius:14px;
                        background:rgba(255,255,255,0.05);
                        backdrop-filter: blur(8px);
                        display:flex;
                        justify-content:space-between;
                        align-items:center;">

                <span>@item.MonthLabel</span>

                <span style="font-weight:600;">
                    £@item.Revenue
                </span>
            </div>
        }
    </div>
}
else
{
    <div style="margin-top:150px; color:white; text-align:center;">
        No revenue data available.
    </div>
}


@code {
    private List<SalesAnalysisModel> salesData = new();

    protected override async Task OnInitializedAsync()
    {
        var apiData = await Http.GetFromJsonAsync<List<SalesAnalysisModel>>(
            "api/analytics/chart") ?? new();

        salesData = apiData.Select(x => new SalesAnalysisModel
        {
            Year = x.Year,
            Month = x.Month,
            Revenue = (double)x.Revenue,
            MonthLabel = new DateTime(x.Year, x.Month, 1).ToString("MMMM yyyy")
        }).ToList();

        StateHasChanged(); 
    }

    public class SalesAnalysisModel
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public double Revenue { get; set; }
        public string MonthLabel { get; set; } = string.Empty;
    }

    private bool chartInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartInitialized && salesData.Any())
        {
            chartInitialized = true;

            var labels = salesData
                .OrderBy(x => x.Year)
                .ThenBy(x => x.Month)
                .Select(x => x.MonthLabel)
                .ToArray();

            var values = salesData
                .OrderBy(x => x.Year)
                .ThenBy(x => x.Month)
                .Select(x => x.Revenue)
                .ToArray();

            await JS.InvokeVoidAsync("loadRevenueChart", labels, values);
        }
    }

}