@attribute [Authorize]
@page "/managenotifications"
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.NotificationDTO
@inject HttpClient Http
@inject NavigationManager Nav


<div class="container py-4">
    <br><br>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold mb-0">Notifications</h3>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3 text-muted">Loading notifications...</p>
        </div>
    }
    else if (!alerts.Any())
    {
        <div class="alert alert-info shadow-sm rounded-3 text-center py-4">
            No notifications available.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">

                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Category</th>
                            <th>Message</th>
                            <th>Created</th>
                            <th class="text-center" style="width:120px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var alert in alerts)
                        {
                            <tr class="notification-row">
                                <td class="ps-4">
                                    <span class="fw-bold @GetBadgeColor(alert.Category)">
                                        @alert.Category
                                    </span>
                                </td>

                                <td class="text-muted">@alert.Message</td>

                                <td class="text-secondary">
                                    @alert.CreatedAt.ToLocalTime().ToString("g")
                                </td>

                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                            @onclick="() => DeleteAlert(alert)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    }
</div>



@code {

    private List<AlertDTO> alerts = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertsAsync();
    }

    private async Task LoadAlertsAsync()
    {
        isLoading = true;

        alerts = await Http
            .GetFromJsonAsync<List<AlertDTO>>("api/alert/list")
            ?? new();

        isLoading = false;
    }

    private async Task DeleteAlert(AlertDTO alert)
    {
        var response = await Http.DeleteAsync($"api/alert/{alert.Id}");

        if (response.IsSuccessStatusCode)
        {
            alerts.Remove(alert);
            StateHasChanged();
        }
    }

    private string GetBadgeColor(string category)
        => category == "Expired"
           ? "text-danger"
           : "text-warning";
}
