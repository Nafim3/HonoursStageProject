@page "/sales/{id:int}"
@using SmartInventoryManagementSystem.Application.DTO
@inject HttpClient Http
@inject NavigationManager Nav

<h3 class="text-info fw-bold mb-4">Sale Details</h3>

@if (sale == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="text-info">Sale #@sale.SaleId</h5>

            <div class="mt-3">
                <strong>Buyer:</strong> @sale.BuyerName
            </div>

            <div>
                <strong>Date:</strong> @sale.SaleDate.ToShortDateString()
            </div>

            <div>
                <strong>Total Amount:</strong> £@sale.TotalAmount
            </div>

        </div>
    </div>

    <h5 class="text-info mb-3">Items</h5>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sale.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.QuantitySold</td>
                    <td>£@item.ProductPrice</td>
                    <td>£@(item.ProductPrice* item.QuantitySold)</td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-outline-secondary mt-3" @onclick="GoBack">
        Back to Sales
    </button>
}

@code {
    [Parameter] public int id { get; set; }

    private GetByID? sale;

    protected override async Task OnInitializedAsync()
    {
        sale = await Http.GetFromJsonAsync<GetByID>($"api/sales/GetSale/{id}");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/sales");
    }
}
