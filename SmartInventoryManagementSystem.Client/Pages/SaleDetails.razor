@page "/sales/{id:int}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.SaleDTO
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS


<!-- Header Card -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body d-flex justify-content-between align-items-center">
        <h3 class="fw-bold text-primary m-0">Sale Details</h3>

        <button class="btn btn-outline-secondary btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i> Back
        </button>
    </div>
</div>

@if (sale == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted">Loading sale details...</p>
    </div>
}
else
{
    <!-- Summary Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h5 class="fw-semibold text-primary mb-3">Summary</h5>

            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Buyer</div>
                <div class="col-8">@sale.BuyerName</div>
            </div>

            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Sale Date</div>
                <div class="col-8">@sale.SaleDate.ToShortDateString()</div>
            </div>

            <div class="row mb-2">
                <div class="col-4 fw-semibold text-muted">Total Amount</div>
                <div class="col-8 fw-bold text-success">£@sale.TotalAmount</div>
            </div>

            <button class="btn btn-primary mt-3"
                    @onclick="DownloadInvoice">
                <i class="bi bi-file-earmark-pdf me-1"></i>
                Download Invoice
            </button>


        </div>
    </div>

    <!-- Items Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="fw-semibold text-primary mb-3">Items</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in sale.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-center">@item.QuantitySold</td>
                                <td class="text-end">£@item.ProductPrice</td>
                                <td class="text-end fw-semibold">
                                    £@(item.ProductPrice* item.QuantitySold)
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}





@code 
{

    [Parameter] public int id { get; set; }
    

    private GetByID? sale;

    protected override async Task OnInitializedAsync()
    {
        sale = await Http.GetFromJsonAsync<GetByID>($"api/sales/GetSale/{id}");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/sales");
    }

    private async Task DownloadInvoice()
    {
        var response = await Http.GetAsync($"api/sales/{id}/invoice");

        if (!response.IsSuccessStatusCode)
            return;

        var bytes = await response.Content.ReadAsByteArrayAsync();

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"invoice-{id}.pdf",
            "application/pdf",
            bytes
        );

    }
}
