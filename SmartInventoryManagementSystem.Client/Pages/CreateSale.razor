@page "/sales/create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.ProductDTO
@inject HttpClient Http


<div class="container py-4">

    <br><br>
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="fw-bold text-primary m-0">Create Sale</h3>

        <a class="btn btn-outline-secondary fw-semibold" href="/dashboard">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Dashboard
        </a>

    </div>



    
    <div class="mb-4">
        <label class="form-label fw-semibold">Buyer Name</label>
        <InputText class="form-control" @bind-Value="buyerName" />
    </div>

    <div class="row">

       
        <div class="col-md-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">

                    <h5 class="text-primary fw-semibold mb-3">Select Product</h5>

                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product</label>
                        <InputSelect class="form-select" @bind-Value="selectedProductId">
                            <option value="0">-- Select Product --</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId">
                                    @p.Name (@p.Quantity in stock)
                                </option>
                            }
                        </InputSelect>
                    </div>

                   
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity</label>
                        <InputText class="form-control"
                                   @bind-Value="selectedQuantityText"
                                   @oninput="ValidateQuantity" />
                    </div>

                   
                    <button class="btn btn-outline-primary"
                            @onclick="AddSelectedProduct"
                            disabled="@(!CanAdd)">
                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                    </button>

                </div>
            </div>
        </div>

        
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h5 class="text-primary fw-semibold mb-3">Cart</h5>

                    @if (!cart.Any())
                    {
                        <div class="text-muted fst-italic py-3">
                            Cart is empty.
                        </div>

                        <div class="mt-3 pt-3 border-top">

                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Total Items</span>
                                <strong>@TotalItems</strong>
                            </div>

                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Total Amount</span>
                                <strong>£@TotalAmount</strong>
                            </div>

                        </div>
                    }
                    else
                    {
                        @foreach (var item in cart)
                        {
                            <div class="d-flex justify-content-between align-items-center border-bottom py-3">

                                
                                <div>
                                    <strong>@item.Name</strong>
                                    <div class="text-muted small">£@item.UnitPrice</div>
                                </div>

                               
                                <div style="width: 80px;">
                                    <InputNumber TValue="int"
                                                 class="form-control form-control-sm"
                                                 Value="@item.Quantity"
                                                 ValueChanged="@(q => UpdateQuantity(item, q))"
                                                 ValueExpression="() => item.Quantity" />
                                </div>

                                
                                <div class="fw-semibold">
                                    £@(Math.Round(item.UnitPrice * item.Quantity, 2))
                                </div>

                                
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => RemoveFromCart(item.ProductId)">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    }

                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(validationMessage))
            {
                <div class="alert alert-warning mt-3">
                    @validationMessage
                </div>
            }

            @if (cart.Any())
            {
                <button class="btn btn-success mt-3" @onclick="SubmitSale">
                    <i class="bi bi-check-circle me-1"></i> Confirm Sale
                </button>
            }

        </div>

    </div>

</div>




@code {

    
    public class CreateSaleRequest
    {
       
        public string BuyerName { get; set; } = "";
        public List<CreateSaleItemRequest> Items { get; set; } = new();
    }

    public class CreateSaleItemRequest
    {
        public int ProductId { get; set; }
        public int Quantity { get; set; }
    }

    public class CreateSaleResponse
    {
        public int SaleId { get; set; }
        public decimal TotalAmount { get; set; }
        public int ItemCount { get; set; }
    }

    private string buyerName = string.Empty;

    private List<ProductListDto> products = new();   
    private int? selectedProductId =0;              
    private int? selectedQuantity = 1;      
    private string selectedQuantityText = "1";

    private void ValidateQuantity(ChangeEventArgs e)
    {
        selectedQuantityText = e.Value?.ToString() ?? "";

        if (int.TryParse(selectedQuantityText, out var value) && value > 0)
        {
            selectedQuantity = value;
        }
        else
        {
            selectedQuantity = null;
        }
    }

    public class CartItem
    {
        public int ProductId { get; set; }
        public string Name { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public int Quantity { get; set; }
        public int Stock { get; set; }
    }

    private List<CartItem> cart = new();

    private int TotalItems => cart.Sum(x => x.Quantity);

    private decimal TotalAmount => cart.Sum(x => x.UnitPrice * x.Quantity);

    private string? validationMessage;



    protected override async Task OnInitializedAsync()
    {
        var result = await Http.GetFromJsonAsync<List<ProductListDto>>("api/product");
        products = result ?? new List<ProductListDto>();
    }

    
    private bool CanAdd =>
        selectedProductId > 0 &&
    selectedQuantity.HasValue &&
    selectedQuantity.Value > 0 &&
    selectedQuantity.Value <= GetSelectedProductStock();

    private int GetSelectedProductStock()
    {
        var p = products.FirstOrDefault(x => x.ProductId == selectedProductId);
        return p?.Quantity ?? 0;
    }

    private void AddSelectedProduct()
    {
        
        if (!selectedQuantity.HasValue || !CanAdd)
            return;

        var product = products.First(x => x.ProductId == selectedProductId);

        var existing = cart.FirstOrDefault(x => x.ProductId == product.ProductId);

        if (existing != null)
        {
            
            var qty = selectedQuantity.Value;

            if (existing.Quantity + qty <= existing.Stock)
            {
                existing.Quantity += qty;
            }
            return;
        }

        
        cart.Add(new CartItem
        {
            ProductId = product.ProductId,
            Name = product.Name ?? string.Empty,
            UnitPrice = product.Price,
            Quantity = selectedQuantity.Value,  
            Stock = product.Quantity
        });

    }

    private void RemoveFromCart(int productId)
    {
        var item = cart.FirstOrDefault(x => x.ProductId == productId);
        if (item != null)
            cart.Remove(item);
    }

    private void UpdateQuantity(CartItem item, int newQty)
    {
        if (newQty <= 0 || newQty > item.Stock)
            return;

        item.Quantity = newQty;
    }

    private async Task SubmitSale()
    {
        validationMessage = null;

       
        if (string.IsNullOrWhiteSpace(buyerName) || buyerName.Length < 2)
        {
            validationMessage = "Buyer name must be at least 2 characters.";
            return;
        }

        
        if (!cart.Any())
        {
            validationMessage = "Cart cannot be empty.";
            return;
        }

       
        if (cart.Any(x => x.Quantity <= 0 || x.Quantity > x.Stock))
        {
            validationMessage = "One or more items have invalid quantities.";
            return;
        }

        
        var request = new CreateSaleRequest
        {
             
            BuyerName = buyerName,
            Items = cart.Select(x => new CreateSaleItemRequest
            {
                ProductId = x.ProductId,
                Quantity = x.Quantity
            }).ToList()
        };

       
        var response = await Http.PostAsJsonAsync("api/sales/CreateSale", request);

        if (!response.IsSuccessStatusCode)
        {
            var errorJson = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();

            if (errorJson != null && errorJson.TryGetValue("msg", out var message))
            {
                validationMessage = message;
            }
            else
            {
                validationMessage = "Failed to submit sale.";
            }

            return;

        }


      
        var result = await response.Content.ReadFromJsonAsync<CreateSaleResponse>();

        if (result != null)
        {
          
            validationMessage = $"Sale completed. Total: £{result.TotalAmount}";

            
            cart.Clear();
            buyerName = "";
        }
        else
        {
            validationMessage = "Sale completed, but could not read response details.";
        }
    }


}


