@page "/register"
@using SmartInventoryManagementSystem.Application.DTO

@inject HttpClient Http
@inject NavigationManager Nav

<h3 class="text-center mb-4">Register</h3>

<div class="register-wrapper">
    <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group mb-3">
            <label>Username</label>
            <InputText class="form-control" @bind-Value="registerModel.UserName" />
        </div>

        <div class="form-group mb-3">
            <label>Email</label>
            <InputText class="form-control" @bind-Value="registerModel.Email" />
        </div>

        <div class="form-group mb-3">
            <label>Password</label>
            <InputText class="form-control" type="password" @bind-Value="registerModel.Password" />
        </div>

        <button class="btn btn-primary w-100" type="submit">Register</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="mt-3 text-center">@message</p>
        }
    </EditForm>
</div>

@code {
    private AuthUserInfo registerModel = new();
    private string? message;

    private async Task HandleRegister()
    {
        var response = await Http.PostAsJsonAsync("api/auth/register", registerModel);

        if (response.IsSuccessStatusCode)
        {
            message = "Registration successful";
            await Task.Delay(1200);
            Nav.NavigateTo("/login");
        }
        else
        {
            message = "User already exists or invalid data";
        }
    }
}
