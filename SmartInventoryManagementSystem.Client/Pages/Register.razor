@page "/register"
@using SmartInventoryManagementSystem.Application.DTO.AuthDTO
@inject HttpClient Http
@inject NavigationManager Nav


<div class="container py-5" style="max-width: 450px;">
    <br><br><br>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="text-center fw-bold text-primary mb-4">
                Register
            </h3>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-info text-center mb-3">
                    @message
                </div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="@HandleRegister">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Username</label>
                    <InputText class="form-control" @bind-Value="registerModel.UserName" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <InputText class="form-control" @bind-Value="registerModel.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="registerModel.Password" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Confirm Password</label>
                    <InputText class="form-control"
                               type="password"
                               @bind-Value="registerModel.ConfirmPassword" />
                </div>

                <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                    <i class="bi bi-person-plus me-1"></i> Register
                </button>

                <div class="text-center mt-3">
                    <span class="text-muted">Already Have an Account?</span>
                    <a href="/login" class="text-primary fw-semibold ms-1">
                        Login Here
                    </a>
                </div>

            </EditForm>

        </div>
    </div>

</div>


@code 
{
    private RegisterUser registerModel = new();
    private string? message;

    private async Task HandleRegister()
    {
        var response = await Http.PostAsJsonAsync("api/auth/Register", registerModel);

        if (response.IsSuccessStatusCode)
        {
            message = "Registration successful";
            await Task.Delay(1200);
            Nav.NavigateTo("/login");
        }
        else
        {
            var errorJson = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            message = errorJson?["message"] ?? "Registration failed";

        }
    }
}
