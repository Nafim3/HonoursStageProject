@page "/prediction/dashboard"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SmartInventoryManagementSystem.Application.DTO.ProductDTO
@using SmartInventoryManagementSystem.Application.DTO.StockPredictionDTO
@inject HttpClient Http


<div class="container py-4">

    <h3 class="text-primary fw-bold mb-4 text-center">
        Inventory Forecasting Insight
    </h3>

    @if (Predictions == null)
    {
        <div class="text-center text-muted py-5">
            <div class="spinner-border text-primary mb-3"></div>
            <p>Loading predictions...</p>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm text-center">
            <thead class="table-primary">
                <tr>
                    <th class="text-center">Product Name</th>
                    <th class="text-center">Average Daily Sales</th>
                    <th class="text-center">Estimated Days Remaining</th>
                    <th class="text-center">Suggested Reorder Quantity</th>
                    <th class="text-center">Stock Risk Level</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Predictions)
                {
                    <tr>
                        <td class="text-center">@item.PName</td>
                        <td class="text-center">@item.Prediction.AverageDailySales.ToString("0.00")</td>
                        <td class="text-center">@item.Prediction.DaysRemaining.ToString("0.00")</td>
                        <td class="text-center">@item.Prediction.SuggestedReorderQuantity</td>
                        <td class="text-center @GetRiskColor(item.Prediction.RiskLevel)">
                            @item.Prediction.RiskLevel
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>



@code 
{
    private List<ProductListDto> Products = new();
    private List<PredictionWrapper>? Predictions;

    protected override async Task OnInitializedAsync()
    {
        Predictions = await Http.GetFromJsonAsync<List<PredictionWrapper>>("api/StockPrediction/prediction");
    }

    private string GetRiskColor(string? risk)
    {
        if (string.IsNullOrEmpty(risk))
            return "";

        return risk switch
        {
            "Critical" => "text-danger fw-bold",
            "High" => "text-warning fw-bold",
            "Medium" => "text-info fw-bold",
            "Safe" => "text-success fw-bold",
            _ => ""
        };
    }

}

